# .gitignore - ComboLab
# Archivos y carpetas a ignorar al subir a GitHub

# Dependencias
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build / distribucion
dist/
build/
*.local

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Variables de entorno / claves sensibles
.env
.env.local
config.local.js

# Logs
*.log
